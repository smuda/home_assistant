{
  "uid": "zaptec-charging",
  "title": "Zaptec Charging",
  "tags": [
    "zaptec",
    "ev"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "homeassistant_sensor_current_a{entity=\"sensor.zag064494_strom_fas_1\"}",
          "legendFormat": "Fas 1"
        },
        {
          "expr": "homeassistant_sensor_current_a{entity=\"sensor.zag064494_strom_fas_2\"}",
          "legendFormat": "Fas 2"
        },
        {
          "expr": "homeassistant_sensor_current_a{entity=\"sensor.zag064494_strom_fas_3\"}",
          "legendFormat": "Fas 3"
        },
        {
          "expr": "homeassistant_number_state_a{entity=\"number.zag064494_max_laddstrom\"}",
          "legendFormat": "Max (konfig)"
        },
        {
          "expr": "homeassistant_sensor_current_a{entity=\"sensor.zag064494_tilldelad_laddstrom\"}",
          "legendFormat": "Tilldelad"
        }
      ],
      "title": "Laddström per fas vs konfigurerad max",
      "description": "Actual charge current drawn per phase, the configured max (the automation's control output) and the current the charger allocates. Watch a session start at 6 A and ramp to 16 A.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Max (konfig)"
            },
            "properties": [
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tilldelad"
            },
            "properties": [
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "super-light-blue",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "homeassistant_sensor_current_a{entity=\"sensor.p1_meter_strom_fas_1\"}",
          "legendFormat": "Fas 1"
        },
        {
          "expr": "homeassistant_sensor_current_a{entity=\"sensor.p1_meter_strom_fas_2\"}",
          "legendFormat": "Fas 2"
        },
        {
          "expr": "homeassistant_sensor_current_a{entity=\"sensor.p1_meter_strom_fas_3\"}",
          "legendFormat": "Fas 3"
        }
      ],
      "title": "Hushållsström per fas vs säkring",
      "description": "Total household current per phase from the P1 meter. The orange line is the automation's effective cap (fuse − margin = 22 A); the red line is the 25 A main fuse.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 22,
                "color": "orange"
              },
              {
                "value": 25,
                "color": "red"
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "homeassistant_sensor_current_a{entity=\"sensor.p1_meter_strom_fas_1\"} - on() homeassistant_sensor_current_a{entity=\"sensor.zag064494_strom_fas_1\"}",
          "legendFormat": "Fas 1"
        },
        {
          "expr": "homeassistant_sensor_current_a{entity=\"sensor.p1_meter_strom_fas_2\"} - on() homeassistant_sensor_current_a{entity=\"sensor.zag064494_strom_fas_2\"}",
          "legendFormat": "Fas 2"
        },
        {
          "expr": "homeassistant_sensor_current_a{entity=\"sensor.p1_meter_strom_fas_3\"} - on() homeassistant_sensor_current_a{entity=\"sensor.zag064494_strom_fas_3\"}",
          "legendFormat": "Fas 3"
        }
      ],
      "title": "Övrig last per fas (P1 − bil) vs stopp-tröskel",
      "description": "Non-car load per phase (P1 meter minus the charger's own current). This is what the automation reacts to. The red line is the last-resort stop threshold: when this reaches ~19 A even 6 A of car current would breach the fuse.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 19,
                "color": "red"
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
