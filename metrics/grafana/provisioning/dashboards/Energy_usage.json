              },
              {
                "id": "custom.axisLabel",
                "value": "Batterinivå (SOC)"
              },
              {
                "id": "custom.axisSoftMin",
                "value": 0
              },
              {
                "id": "custom.axisSoftMax",
                "value": 100
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
