        },
        {
          "expr": "homeassistant_sensor_battery_percent{entity=\"sensor.battery_level\"}",
          "legendFormat": "Batterinivå"
        }
      ],
      "title": "Sungrow Inverter",
      "description": "Energy the Sungrow inverter delivered to the house from solar and the battery (total consumption minus grid import). This is the local generation that no longer shows up as grid import, and it is what the Unknown Usage panel now adds back. The battery state of charge (right axis) shows whether the battery was charging or discharging.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "repeatDirection": "h",
      "interval": "1h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
